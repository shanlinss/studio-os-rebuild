{
  "name": "studio-os-rebuild",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev:cloud": "node dev/read-only-preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:server": "tsc -p studio/tsconfig.server.json",
    "test:backend": "npm run build:server && node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "dev:integrated": "npm run build:server && node dev/integrated-preview.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "drizzle-orm": "0.44.6",
    "express": "4.22.1",
    "postgres": "3.4.9",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "embedded-postgres": "18.6.0-beta.19"
  }
}
